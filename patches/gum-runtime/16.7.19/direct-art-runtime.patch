+def _read_bridge_files(directory):
+    if not directory.is_absolute() or not directory.is_dir():
+        raise ValueError("Java bridge source must be an existing absolute package path")
+    if directory.is_symlink() or any(parent.is_symlink() for parent in directory.parents):
+        raise ValueError("Java bridge path must not contain symlinks")
+    files = {}
+    for path in directory.rglob("*"):
+        if path.is_symlink():
+            raise ValueError("Java bridge package must not contain symlinks")
+        if path.is_dir():
+            continue
+        if not path.is_file():
+            raise ValueError("Java bridge package must contain regular files")
+        files[path.relative_to(directory).as_posix()] = path.read_bytes()
+    return files
+
+
+def _bridge_hashes(files):
+    import hashlib
+    return {relative: hashlib.sha256(data).hexdigest() for relative, data in sorted(files.items())}
+
+
+def _prepare_bridge_inputs(bridge_source, output_dir, priv_dir):
+    if not bridge_source.is_absolute():
+        raise ValueError("Java bridge source path must be absolute")
+    for path in (output_dir, priv_dir):
+        if not path.is_absolute() or path.is_symlink() or any(parent.is_symlink() for parent in path.parents):
+            raise ValueError("Java runtime output/cache paths must be absolute and not symlinks")
+    if any(bridge_source.resolve().is_relative_to(path.resolve())
+           or path.resolve().is_relative_to(bridge_source.resolve()) for path in (output_dir, priv_dir)):
+        raise ValueError("Java bridge source must be separate from runtime output and cache")
+    contents = _read_bridge_files(bridge_source)
+    if _bridge_hashes(contents) != NIANCHU_BRIDGE_RESULT_HASHES:
+        raise ValueError("direct-art-gc bridge package identity mismatch")
+    return contents
+
+
+def _stage_bridge_inputs(contents, priv_dir):
+    destination = priv_dir / "node_modules" / "frida-java-bridge"
+    actual = _bridge_hashes(_read_bridge_files(destination))
+    if actual not in (NIANCHU_BRIDGE_BASE_HASHES, NIANCHU_BRIDGE_RESULT_HASHES):
+        raise ValueError("runtime Java bridge cache drift or partial profile")
+    changed = [relative for relative in contents
+               if NIANCHU_BRIDGE_BASE_HASHES[relative] != NIANCHU_BRIDGE_RESULT_HASHES[relative]]
+    staged = []
+    try:
+        for relative in changed:
+            path = destination / relative
+            temporary = path.with_name(path.name + ".nianchu-tmp")
+            with temporary.open("xb") as output:
+                output.write(contents[relative])
+            temporary.chmod(path.stat().st_mode & 0o777)
+            staged.append((temporary, path))
+        for temporary, path in staged:
+            os.replace(temporary, path)
+    finally:
+        for temporary, _ in staged:
+            if temporary.exists():
+                temporary.unlink()
+    if _bridge_hashes(_read_bridge_files(destination)) != NIANCHU_BRIDGE_RESULT_HASHES:
+        raise ValueError("runtime Java bridge staging identity mismatch")
